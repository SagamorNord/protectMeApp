<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="bottom"
        android:height="3dp"
        >
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/black_transparent_16"
                android:centerColor="@color/black_transparent_8"
                android:endColor="@color/black_transparent_4"
                android:angle="90"
                />
        </shape>
    </item>

    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white"/>
        </shape>
    </item>
</layer-list>